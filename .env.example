# ============================================================================
# STRATAAI - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# This is a TEMPLATE file. It shows what API keys are needed but contains
# NO actual secrets. This file IS committed to Git so collaborators know
# which environment variables to set up.
#
# HOW TO USE:
# 1. Copy this file:  cp .env.example .env
# 2. Open .env and paste your real API keys
# 3. NEVER commit .env (it's in .gitignore)
#
# WHERE TO GET THESE KEYS:
# - Gemini: https://aistudio.google.com/apikey
# - Groq:   https://console.groq.com/keys
# ============================================================================

# --- Google Gemini API Key ---
# Used for: RAG chat responses, explanations, quiz generation, answer evaluation
# Free tier: 60 requests per minute (generous for development)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Groq API Key ---
# Used for: Fast LLM inference (alternative to Gemini)
# Why Groq? It runs open-source models (Llama, Mixtral) on custom hardware
# that's 10-50x faster than GPU inference. Great for quick responses.
GROQ_API_KEY=your_groq_api_key_here
